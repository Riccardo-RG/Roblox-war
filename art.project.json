{
  "name": "WarWorld Art Authoring",
  "tree": {
    "$className": "DataModel",
    "ServerStorage": {
      "$className": "ServerStorage",
      "WorldArtLibrary": {
        "$className": "Folder"
      }
    },
    "Workspace": {
      "$className": "Workspace",
      "$properties": {
        "StreamingEnabled": false
      },
      "ArtPreview": {
        "$className": "Folder"
      },
      "PreviewFloor": {
        "$className": "Part",
        "$properties": {
          "Anchored": true,
          "Size": [100, 1, 100],
          "Position": [0, -0.5, 0],
          "Color": [0.43, 0.46, 0.43],
          "Material": "Concrete",
          "TopSurface": "Smooth",
          "BottomSurface": "Smooth"
        }
      },
      "PreviewOrigin": {
        "$className": "Part",
        "$properties": {
          "Anchored": true,
          "CanCollide": false,
          "Size": [4, 0.05, 4],
          "Position": [0, 0.025, 0],
          "Color": [0.62, 0.73, 0.67],
          "Material": "SmoothPlastic"
        }
      }
    },
    "Lighting": {
      "$className": "Lighting",
      "$properties": {
        "Ambient": [0.44, 0.46, 0.47],
        "OutdoorAmbient": [0.58, 0.6, 0.62],
        "Brightness": 2,
        "ClockTime": 14.1,
        "ExposureCompensation": 0,
        "EnvironmentDiffuseScale": 0.65,
        "EnvironmentSpecularScale": 0.3,
        "GlobalShadows": true,
        "LightingStyle": "Realistic",
        "ShadowSoftness": 0.3
      }
    }
  }
}
