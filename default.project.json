{
  "name": "WarWorld",
  "servePort": 34872,
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "$className": "ReplicatedStorage",
      "rbxts_include": {
        "$path": "include",
        "node_modules": {
          "$className": "Folder",
          "@rbxts": {
            "$path": "node_modules/@rbxts"
          }
        }
      },
      "Shared": {
        "$path": "out/shared"
      }
    },
    "ServerScriptService": {
      "$className": "ServerScriptService",
      "WarWorldServer": {
        "$path": "out/server"
      }
    },
    "ServerStorage": {
      "$className": "ServerStorage",
      "WorldArtLibrary": {
        "$path": "assets/original/world-kit/WorldArtLibrary.rbxmx"
      }
    },
    "StarterPlayer": {
      "$className": "StarterPlayer",
      "$properties": {
        "CameraMaxZoomDistance": 0.5,
        "CameraMinZoomDistance": 0.5,
        "CameraMode": "LockFirstPerson",
        "CharacterWalkSpeed": 18,
        "CharacterJumpHeight": 7.2,
        "EnableMouseLockOption": false
      },
      "StarterPlayerScripts": {
        "$className": "StarterPlayerScripts",
        "WarWorldClient": {
          "$path": "out/client"
        }
      }
    },
    "Workspace": {
      "$className": "Workspace",
      "$properties": {
        "StreamingEnabled": true,
        "StreamingMinRadius": 96,
        "StreamingTargetRadius": 256,
        "FallenPartsDestroyHeight": -80,
        "Gravity": 196.2
      },
      "World": {
        "$className": "Folder"
      }
    },
    "Lighting": {
      "$className": "Lighting",
      "$properties": {
        "Ambient": [0.27451, 0.290196, 0.321569],
        "Brightness": 2.05,
        "ClockTime": 15.2,
        "EnvironmentDiffuseScale": 0.55,
        "EnvironmentSpecularScale": 0.4,
        "ExposureCompensation": -0.08,
        "GlobalShadows": true,
        "LightingStyle": "Realistic",
        "OutdoorAmbient": [0.556863, 0.588235, 0.619608],
        "PrioritizeLightingQuality": true,
        "ShadowSoftness": 0.18,
        "Technology": "Voxel"
      }
    }
  }
}
