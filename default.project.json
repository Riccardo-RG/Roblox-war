{
  "name": "WarWorld",
  "servePort": 34872,
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "$className": "ReplicatedStorage",
      "rbxts_include": {
        "$path": "include",
        "node_modules": {
          "$className": "Folder",
          "@rbxts": {
            "$path": "node_modules/@rbxts"
          }
        }
      },
      "Shared": {
        "$path": "out/shared"
      }
    },
    "ServerScriptService": {
      "$className": "ServerScriptService",
      "WarWorldServer": {
        "$path": "out/server"
      }
    },
    "StarterPlayer": {
      "$className": "StarterPlayer",
      "$properties": {
        "CharacterWalkSpeed": 18,
        "CharacterJumpHeight": 7.2,
        "EnableMouseLockOption": true
      },
      "StarterPlayerScripts": {
        "$className": "StarterPlayerScripts",
        "WarWorldClient": {
          "$path": "out/client"
        }
      }
    },
    "Workspace": {
      "$className": "Workspace",
      "$properties": {
        "StreamingEnabled": true,
        "StreamingMinRadius": 96,
        "StreamingTargetRadius": 256,
        "FallenPartsDestroyHeight": -80,
        "Gravity": 196.2
      },
      "World": {
        "$className": "Folder"
      }
    },
    "Lighting": {
      "$className": "Lighting",
      "$properties": {
        "Ambient": [90, 105, 125],
        "Brightness": 2.5,
        "ClockTime": 14,
        "EnvironmentDiffuseScale": 0.35,
        "EnvironmentSpecularScale": 0.5,
        "GlobalShadows": true,
        "OutdoorAmbient": [125, 135, 150],
        "Technology": "Voxel"
      }
    }
  }
}
